{
  "name": "pi-websearch",
  "version": "1.6.1",
  "description": "Web search tools for pi, backed by independent engines (mwmbl + Mojeek) with Kagi, then keyless DuckDuckGo Lite and an optional SearXNG instance as fallbacks",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "web-search",
    "mwmbl",
    "mojeek",
    "kagi",
    "searxng",
    "github",
    "usage-meter"
  ],
  "license": "MIT",
  "files": [
    "src",
    "scripts",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "linkedom": "^0.16.0",
    "turndown": "^7.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --import ./test/ts-resolve.mjs --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  }
}
